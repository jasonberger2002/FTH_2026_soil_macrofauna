@article{Lassabatere2006,
  title = {Beerkan Estimation of Soil Transfer Parameters through Infiltration Experiments-{{BEST}}},
  author = {Lassabat{\`e}re, Laurent and {Angulo-Jaramillo}, Rafa{\"e}l and Ugalde, J. M. Soria and Cuenca, R. and Braud, Isabelle and Haverkamp, R.},
  year = 2006,
  journal = {Soil Science Society of America Journal},
  volume = {70},
  pages = {521},
  doi = {10.2136/sssaj2005.0026},
  urldate = {2026-11-13},
  abstract = {Studying soil hydrological processes requires the determination of soil hydraulic parameters whose assessment using traditional methods is expensive and time-consuming. A specific method, Beerkan estimation of soil transfer parameters referred to as BEST was developped to facilitate the determination of both the water retention curve, theta(h), and the hydraulic conductivity curve, K(theta), defined by their shape and scale parameters. BEST estimates shape parameters from particle-size distribution analaysis and scale parameters from infiltration experiments at null pressure head. Saturated water content is measured directly at the end of the infiltration. Hydraulic conductivity and water pressure scale parameters are calculated from the steady-state infiltration rate and prior etimation of sorptivity (S). This is provided by fitting transient infiltration data on the classical two-term equations with values from zero to a maximum corresponding to null hydraulic conductivity and using a data subset for which the two-term infirlation equations are verified as valid. BEST was compared with other fitting methods to estimate sorptivity and hydraulic conductivity from infiltration modeling data on the basis of the same infiltration equations for three contrasting soils: agricultural soil, sandy soil and a coarser fluvioglacial deposit. The other methods failed sometimes to model accurately experimental data and to provide values in agreement with physical principles of water infiltration (negative values for hyraulic conductivity, too high steady-state infiltration rate). None of these anomalies was encountered when modeling cumulative infiltration with BEST. BEST appears to be a promising, esasy, robust, and inexpensive way of characterizing the hydraulic behaviour of soil.},
  langid = {english},
  file = {C:\Users\jason\Zotero\storage\WZRS9Y6U\hal-02587728.html}
}

